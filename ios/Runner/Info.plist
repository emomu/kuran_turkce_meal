<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tilavet ekran kapalıyken de sürer; kilit ekranından
	     kontrol edilebilmesi için arka plan ses modu gerekir. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Uygulama mikrofon kaydı yapmaz. Bu anahtar yalnızca tilavet oynatıcısının
	     kullandığı AVAudioSession API'si kayıt kategorilerine de erişebildiği için
	     Apple tarafından zorunlu tutulur (App Store doğrulama kodu 90683). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Bu uygulama mikrofonu kullanmaz. Bu izin, tilavet sesinin telefon görüşmesi ve kulaklık durumlarıyla uyumlu çalması için gereken sistem ses ayarları nedeniyle istenir.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Kur'an Meal</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Kuran Meal</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Uygulama şifreleme kullanmaz; bu anahtar olmadan her yüklemede
	     ihracat uyumluluğu sorusu yeniden sorulur. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Ana ekran ve kilit ekranı araçları uygulamayı bu şemayla açar;
	     taşınan yol Flutter tarafında yönlendiriciye devredilir. Şema
	     uygulamaya özel; dışarıdan tetiklenmesi yalnızca uygulama içi bir
	     ekrana gitmeye yarar. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.emirhansoylu.kuranmeal.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>homeWidget</string>
			</array>
		</dict>
	</array>
	<!-- Türkçe arayüz ve meal; mağaza birincil dili buradan da okunur. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>tr</string>
		<string>en</string>
	</array>
</dict>
</plist>
