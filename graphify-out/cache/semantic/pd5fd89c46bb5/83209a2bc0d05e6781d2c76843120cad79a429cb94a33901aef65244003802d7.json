{"nodes": [{"id": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher_icon", "label": "App Launcher Icon (xxxhdpi, 192x192)", "file_type": "image", "source_file": "android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher_flutter_default_branding", "label": "Unreplaced Flutter Default Branding", "file_type": "rationale", "source_file": "android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All five launcher icons are the stock Flutter 'F' chevron logo (light blue #54C5F8 upper stroke, mid blue over a dark navy #01579B fold) on transparent, shipped verbatim by `flutter create`. They were never replaced with app-specific artwork for this Turkish Quran translation (kuran_turkce_meal) app. Consequence: on-device the app is visually indistinguishable from every other unbranded Flutter project, and store submission would surface it as generic. Design intent is therefore absent rather than deliberate \u2014 this is scaffolding residue, not a branding decision."}], "edges": [{"source": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher_icon", "target": "android_app_src_main_res_mipmap_mdpi_ic_launcher_density_bucket_ladder", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png", "source_location": null, "weight": 1.0}, {"source": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher_flutter_default_branding", "target": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher_icon", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png", "source_location": null, "weight": 1.0}, {"source": "android_app_src