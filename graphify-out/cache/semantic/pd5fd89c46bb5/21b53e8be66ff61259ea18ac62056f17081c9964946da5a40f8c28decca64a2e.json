{"nodes": [{"id": "android_app_src_main_res_mipmap_mdpi_ic_launcher_icon", "label": "App Launcher Icon (mdpi, 48x48)", "file_type": "image", "source_file": "android/app/src/main/res/mipmap-mdpi/ic_launcher.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "android_app_src_main_res_mipmap_mdpi_ic_launcher_density_bucket_ladder", "label": "Android Density Bucket Ladder", "file_type": "concept", "source_file": "android/app/src/main/res/mipmap-mdpi/ic_launcher.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured sizes 48/72/96/144/192 px form the canonical 1x/1.5x/2x/3x/4x Android scale ladder off a 48dp baseline. Android resolves `@mipmap/ic_launcher` by matching the device's screen density to the nearest bucket, so the five files are one logical asset pre-rasterized per bucket, not five distinct icons. Trade-off: raster-per-density costs APK size and must be regenerated in lockstep on any art change, but it avoids runtime scaling blur on the launcher surface."}], "edges": [{"source": "android_app_src_main_res_mipmap_mdpi_ic_launcher_icon", "target": "android_app_src_main_res_mipmap_mdpi_ic_launcher_density_bucket_ladder", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "android/app/src/main/res/mipmap-mdpi/ic_launcher.png", "source_location": null, "weight": 1.0}, {"source": "android_app_src_main_res_mipmap_mdpi_ic_launcher_icon", "target": "android_app_src_main_res_mipmap_xxxhdpi_ic_launcher_icon", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "android/app/src/main/res/mipmap-mdpi/ic_launcher.png", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "ic_launcher_density_variant_set", "label": "ic_launcher Density Variant Set (one logical asset, five rasterizations)", "nodes": ["android_app_src_main_res_mipmap_mdpi_i