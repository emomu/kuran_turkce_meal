<?xml version="1.0" encoding="utf-8"?>
<!-- Günün ayeti aracının künyesi.
     minWidth/minHeight eski Android'ler için, targetCell* Android 12+ için;
     ikisi de verilir çünkü hücre tabanlı ölçü yalnızca yeni sürümlerde var.
     Ayet metni için 4x2 hücre en küçük okunabilir boy. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_daily_ayah"
    android:previewLayout="@layout/widget_daily_ayah"
    android:description="@string/widget_daily_ayah_description"
    android:updatePeriodMillis="0" />
