<?xml version="1.0" encoding="utf-8"?>
<!-- Günün ayeti aracı.
     Araçlar RemoteViews ile çizilir; yalnızca sınırlı sayıda görünüm türü
     desteklenir (ConstraintLayout desteklenmez), bu yüzden düzen iç içe
     LinearLayout ile kurulur.

     Metin satır sayısı sabit değil: araç yüksekliği kullanıcı tarafından
     değiştirilebiliyor. maxLines yerine ağırlık (weight) verilerek metin
     kalan alanı doldurur, sığmayan kısım kırpılır. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/Theme.WidgetContainer">

    <!-- Üst satır: bölüm etiketi ve yenile düğmesi. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_daily_ayah_label"
            android:textColor="@color/widget_ink_faint"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold" />

        <!-- Yenile: rastgele başka bir ayet gösterir. Dokunma alanı
             simgeden büyük tutuldu; 20dp'lik bir simgeye parmakla isabet
             ettirmek zor. -->
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <!-- Ayet metni. Kalan alanı doldurur. -->
    <TextView
        android:id="@+id/ayah_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_ink"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.35"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/ayah_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textStyle="bold" />
</LinearLayout>
