<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- İşletim sistemi açık temadayken, süreç başlarken pencereye uygulanır. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Açılış zemini. Flutter ilk kareyi çizince kendiliğinden kalkar. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Süreç başladıktan sonra pencereye uygulanır. Flutter arayüzü
         hazırlanırken ve arayüzün arkasında görünen zemini belirler. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
