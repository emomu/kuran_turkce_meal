  "alak": [
    {
      "n": 1,
      "tr": "Yaratan Rabbinin adıyla oku",
      "en": "Read! In the name of your Lord who created",
      "ar": "ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ"
    },
    {
      "n": 2,
      "tr": "O, insanı bir alekadan (embriyodan) yarattı",
      "en": "He created man from a clinging form",
      "ar": "خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ"
    },
    {
      "n": 3,
      "tr": "Oku! Rabbin sonsuz kerem sahibidir",
      "en": "Read! Your Lord is the Most Bountiful One",
      "ar": "ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ"
    },
    {
      "n": 4,
      "tr": "O Rab ki kalemle yazmayı öğretti",
      "en": "who taught by [means of] the pen",
      "ar": "ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ"
    },
    {
      "n": 5,
      "tr": "İnsana bilmediği şeyleri öğretti",
      "en": "who taught man what he did not know",
      "ar": "عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ"
    },
    {
      "n": 6,
      "tr": "Hayır! Doğrusu (kâfir) insan azgınlık eder",
      "en": "But man exceeds all bounds",
      "ar": "كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ"
    },
    {
      "n": 7,
      "tr": "Kendisinin muhtaç olmadığını zannettiği için",
      "en": "when he thinks he is self-sufficient",
      "ar": "أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ"
    },
    {
      "n": 8,
      "tr": "Muhakkak ki dönüş mutlaka Rabbinedir",
      "en": "[Prophet], all will return to your Lord",
      "ar": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ"
    }
  ],
  "searchResults": [
    {
      "surah": "Bakara",
      "surahEn": "Al-Baqarah",
      "n": 153,
      "tr": "Ey iman edenler! Sabır ve namazla yardım isteyin. Şüphe yok ki Allah, sabredenlerle beraberdir",
      "en": "You who believe, seek help through steadfastness and prayer, for God is with the steadfast"
    },
    {
      "surah": "Bakara",
      "surahEn": "Al-Baqarah",
      "n": 155,
      "tr": "Çaresiz biz sizi biraz korku, biraz açlık, biraz da mallardan, canlardan ve ürünlerden eksiltme ile imtihan edeceğiz. Müjdele o sabredenleri",
      "en": "We shall certainly test you with fear and hunger, and loss of property, lives, and crops. But [Prophet], give good news to those who are steadfast"
    },
    {
      "surah": "Âl-i İmrân",
      "surahEn": "Ali 'Imran",
      "n": 17,
      "tr": "O sabredenleri, o doğruluktan şaşmayanları, o elpençe divan duranları, o nafaka verenleri ve seher vakitlerinde o istiğfar edip yalvaranları (görür)",
      "en": "those who are steadfast, truthful, truly devout, who give [in God’s cause] and pray before dawn for forgiveness.’"
    },
    {
      "surah": "Âl-i İmrân",
      "surahEn": "Ali 'Imran",
      "n": 120,
      "tr": "Size bir iyilik dokunsa fenalarına gider, başınıza bir kötülük gelse onunla sevinirler. Eğer sabreder ve Allah'dan gereğince korkarsanız, onların hileleri size hiçbir zarar vermez; çünkü Allah onları kendi amelleriyle kuşatmıştır",
      "en": "They grieve at any good that befalls you [believers] and rejoice at your misfortunes. But if you are steadfast and conscious of God, their scheming will not harm you in the least: God encircles everything they do"
    }
  ],
